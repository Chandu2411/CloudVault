# ============================================================
# CloudVault Migrator — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------
# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/
# Credentials > OAuth 2.0 Client IDs > Web Application
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------
# Token Encryption Key (AES-256)
# MUST be exactly 32 characters
# Generate a random 32-char string — KEEP THIS SECRET
# Example: openssl rand -hex 16 (gives 32 hex chars)
# ------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=replace-this-with-32-char-secret!

# ------------------------------------------------------------
# PostgreSQL Database (for production)
# Leave blank to use H2 in-memory database for development
# ------------------------------------------------------------
DB_USERNAME=cloudvault_user
DB_PASSWORD=your_strong_db_password

# ------------------------------------------------------------
# Spring Profile
# Use 'dev' for H2 in-memory, 'prod' for PostgreSQL
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
