  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime flow",
      "items": [
        "The browser lists source files, requests a plan, then starts a transfer job.",
        "The plan creates an item for each selected file and selected destination account.",
        "An async worker streams each file, verifies the destination, and trashes the source only in CUT mode after verification."
      ]
    },
    {
      "dot": "emerald",
      "title": "Identity and progress",
      "items": [
        "Local register/login endpoints issue JWTs; Axios attaches the token to API requests.",
        "Google OAuth callbacks link source or destination accounts and persist encrypted OAuth tokens.",
        "CountingInputStream updates in-memory progress; the API emits snapshots to the transfer screen over SSE."
      ]
    },
    {
      "dot": "rose",
      "title": "Deployment and persistence",
      "items": [
        "Compose exposes the frontend on host port 5173 and the backend on 9090, with a named volume mounted at /app/data.",
        "The configured datasource is file-backed H2; PostgreSQL settings and driver are present as an alternative.",
        "Jenkins packages and tests backend/frontend, then rebuilds and starts the Compose services."
      ]
    }
  ]
